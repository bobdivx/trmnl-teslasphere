{% render 'shared' %}

<div class="layout layout--row gap--medium flex--center">
  <div class="flex flex--col flex--center">
    <span class="value value--xxxlarge value--tnums">{{ battery_level }}%</span>
    <span class="label">Battery</span>
  </div>
  <div class="columns w--full">
    <div class="column">
      <div class="item"><div class="content">
        <span class="value value--xlarge value--tnums">{{ range_value }} {{ range_unit }}</span>
        <span class="label">Range</span>
      </div></div>
      <div class="item mt--small"><div class="content">
        <span class="value value--large clamp clamp--1">{{ charging_state }}</span>
        <span class="label">Status</span>
      </div></div>
    </div>
    <div class="column">
      <div class="item"><div class="content">
        <span class="value value--xlarge value--tnums">{{ power_display }}</span>
        <span class="label">Power</span>
      </div></div>
      <div class="item mt--small"><div class="content">
        <span class="value value--large value--tnums">{{ time_display }}</span>
        <span class="label">{{ time_to_limit_label }}</span>
      </div></div>
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCA2NCA2NCIgZmlsbD0iYmxhY2siPjxwYXRoIGQ9Ik04IDE0aDQ4djZIMzZ2MzRoLThWMjBIOHoiLz48cGF0aCBkPSJNMTIgMTBjOC00IDMyLTQgNDAgMHY0Yy04LTMtMzItMy00MCAweiIvPjwvc3ZnPg==" alt="Tesla" />
  <span class="title">Tesla</span>
  <span class="instance">{{ instance_label }}</span>
</div>
