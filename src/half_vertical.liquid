{% comment %}TeslaSphere half vertical{% endcomment %}
{% assign battery_level = battery_level | default: usable_battery_level | default: 0 | plus: 0 %}
{% if battery_level > 100 %}{% assign battery_level = 100 %}{% endif %}
{% if battery_level < 0 %}{% assign battery_level = 0 %}{% endif %}
{% assign charge_limit = charge_limit_soc | default: 80 | plus: 0 %}
{% assign battery_range_raw = battery_range | default: 0 | plus: 0 %}
{% assign hours_to_limit = minutes_to_full_charge | default: time_to_full_charge | default: 0 | plus: 0 %}
{% assign charging_state = charging_state | default: "Inconnu" %}
{% assign charger_power = charger_power | default: 0 | plus: 0 %}
{% assign vehicle_name = display_name | default: "Tesla" %}
{% assign ts_ms = last_updated_at | default: timestamp | default: 0 | plus: 0 %}
{% assign distance_units = gui_distance_units | default: "km/hr" %}
{% if distance_units contains "mi" %}{% assign range_unit = "mi" %}{% assign range_value = battery_range_raw | round %}{% else %}{% assign range_unit = "km" %}{% assign range_value = battery_range_raw | times: 1.60934 | round %}{% endif %}
{% assign power_display = charger_power | round: 1 | append: " kW" %}
{% assign mins_total = hours_to_limit | times: 60 | round %}
{% if mins_total >= 60 %}{% assign hrs = mins_total | divided_by: 60 %}{% assign mins = mins_total | modulo: 60 %}{% if mins > 0 %}{% assign time_display = hrs | append: "h " | append: mins | append: "min" %}{% else %}{% assign time_display = hrs | append: "h" %}{% endif %}{% elsif mins_total > 0 %}{% assign time_display = mins_total | append: " min" %}{% else %}{% assign time_display = "—" %}{% endif %}
{% if ts_ms > 1000000000000 %}{% assign ts_sec = ts_ms | divided_by: 1000 %}{% else %}{% assign ts_sec = ts_ms %}{% endif %}
{% if ts_sec > 0 %}{% assign updated_at = ts_sec | date: "%d/%m %H:%M" %}{% else %}{% assign updated_at = "" %}{% endif %}
{% if updated_at != "" %}{% assign instance_label = vehicle_name | append: " · " | append: updated_at %}{% else %}{% assign instance_label = vehicle_name %}{% endif %}
<style>
  .ts-hv .stack { display: flex; flex-direction: column; gap: 10px; flex: 1; min-height: 0; }
  .ts-hv .top { display: flex; align-items: baseline; justify-content: space-between; }
  .ts-hv .soc { font-size: 56px; line-height: 0.9; font-weight: 600; }
  .ts-hv .status { font-size: 16px; font-weight: 500; text-transform: capitalize; max-width: 45%; text-align: right; }
  .ts-hv .track { height: 12px; border: 2px solid #000; }
  .ts-hv .fill { height: 100%; background: #000; }
  .ts-hv .limit { font-size: 12px; font-weight: 600; }
  .ts-hv .grid { display: grid; grid-template-columns: 1fr 1fr; border-top: 2px solid #000; flex: 1; }
  .ts-hv .cell { padding: 10px 10px 6px; min-width: 0; }
  .ts-hv .cell:nth-child(even) { border-left: 1px solid #000; }
  .ts-hv .cell:nth-child(n+3) { border-top: 1px solid #000; }
  .ts-hv .cell .value { display: block; font-size: 22px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ts-hv .cell .label { display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 2px; }
</style>
<div class="view view--half_vertical ts-hv">
  <div class="layout layout--col gap--none stack">
    <div class="top">
      <div><span class="soc value--tnums">{{ battery_level }}</span><span style="font-size:24px;font-weight:600;">%</span></div>
      <span class="status" data-clamp="1">{{ charging_state }}</span>
    </div>
    <div class="track"><div class="fill" style="width: {{ battery_level }}%;"></div></div>
    <div class="limit">Limite {{ charge_limit }}%</div>
    <div class="grid">
      <div class="cell"><span class="value value--tnums">{{ range_value }} {{ range_unit }}</span><span class="label">Autonomie</span></div>
      <div class="cell"><span class="value value--tnums">{{ power_display }}</span><span class="label">Puissance</span></div>
      <div class="cell"><span class="value value--tnums">{{ time_display }}</span><span class="label">Fin de charge</span></div>
      <div class="cell"><span class="value value--tnums">{{ charge_limit }}%</span><span class="label">Objectif</span></div>
    </div>
  </div>
  <div class="title_bar">
    <svg class="image" viewBox="0 0 32 32" role="img" aria-label="TeslaSphere" xmlns="http://www.w3.org/2000/svg"><circle cx="16" cy="16" r="12" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="16" cy="16" r="5" fill="currentColor"/></svg>
    <span class="title">TeslaSphere</span>
    <span class="instance">{{ instance_label }}</span>
  </div>
</div>
