{% comment %}TeslaSphere TRMNL — batterie, charge, ville, Sentinel{% endcomment %}
{% assign battery_level = battery_level | default: usable_battery_level | default: 0 | plus: 0 %}
{% if battery_level > 100 %}{% assign battery_level = 100 %}{% endif %}
{% if battery_level < 0 %}{% assign battery_level = 0 %}{% endif %}
{% assign charge_limit = charge_limit_soc | default: 80 | plus: 0 %}
{% assign vehicle_name = display_name | default: "Tesla" %}
{% assign charge_text = charging_label | default: charging_state | default: "Inconnu" %}
{% assign city_text = city | default: "—" %}
{% assign sentry_text = sentry_label | default: "—" %}
{% assign is_fresh = data_fresh %}
{% if is_fresh == true or is_fresh == "true" %}
  {% assign freshness_label = "Données live" %}
{% else %}
  {% assign freshness_label = "Données en cache" %}
{% endif %}

<div class="layout layout--col gap--medium">
  <div class="flex flex--row flex--between flex--cross-end">
    <span class="value value--xlarge value--tnums">{{ battery_level }}%</span>
    <span class="value value--small text--right" data-clamp="1">{{ charge_text }}</span>
  </div>
  <div class="progress-bar progress-bar--small">
    <div class="track">
      <div class="fill" style="width: {{ battery_level }}%"></div>
    </div>
  </div>
  <div class="item gap--xsmall">
    <span class="label label--xsmall text--gray-40">Ville</span>
    <span class="value" data-clamp="1">{{ city_text }}</span>
  </div>
  <div class="item gap--xsmall">
    <span class="label label--xsmall text--gray-40">Sentinel</span>
    <span class="value" data-clamp="1">{{ sentry_text }}</span>
  </div>
</div>
<div class="title_bar">
  <span class="title">TeslaSphere</span>
  <span class="instance">{{ vehicle_name }}</span>
</div>
