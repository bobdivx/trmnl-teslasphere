{% comment %}TeslaSphere full — editorial e-ink dashboard (no Highcharts){% endcomment %}
{% assign battery_level = battery_level | default: usable_battery_level | default: 0 | plus: 0 %}
{% if battery_level > 100 %}{% assign battery_level = 100 %}{% endif %}
{% if battery_level < 0 %}{% assign battery_level = 0 %}{% endif %}
{% assign charge_limit = charge_limit_soc | default: 80 | plus: 0 %}
{% assign battery_range_raw = battery_range | default: 0 | plus: 0 %}
{% assign energy_added = charge_energy_added | default: 0 | plus: 0 %}
{% assign hours_to_limit = minutes_to_full_charge | default: time_to_full_charge | default: 0 | plus: 0 %}
{% assign charging_state = charging_state | default: "Inconnu" %}
{% assign charger_power = charger_power | default: 0 | plus: 0 %}
{% assign odometer_raw = odometer | default: 0 | plus: 0 %}
{% assign vehicle_name = display_name | default: "Tesla" %}
{% assign vehicle_state = state | default: "" %}
{% assign ts_ms = last_updated_at | default: timestamp | default: 0 | plus: 0 %}
{% assign distance_units = gui_distance_units | default: "km/hr" %}
{% if distance_units contains "mi" %}
  {% assign range_unit = "mi" %}
  {% assign odo_unit = "mi" %}
  {% assign range_value = battery_range_raw | round %}
  {% assign odo_for_compact = odometer_raw %}
{% else %}
  {% assign range_unit = "km" %}
  {% assign odo_unit = "km" %}
  {% assign range_value = battery_range_raw | times: 1.60934 | round %}
  {% assign odo_for_compact = odometer_raw | times: 1.60934 %}
{% endif %}
{% assign energy_display = energy_added | round: 1 | append: " kWh" %}
{% assign power_display = charger_power | round: 1 | append: " kW" %}
{% assign mins_total = hours_to_limit | times: 60 | round %}
{% if mins_total >= 60 %}
  {% assign hrs = mins_total | divided_by: 60 %}
  {% assign mins = mins_total | modulo: 60 %}
  {% if mins > 0 %}{% assign time_display = hrs | append: "h " | append: mins | append: "min" %}{% else %}{% assign time_display = hrs | append: "h" %}{% endif %}
{% elsif mins_total > 0 %}
  {% assign time_display = mins_total | append: " min" %}
{% else %}
  {% assign time_display = "—" %}
{% endif %}
{% assign odo_thousands = odo_for_compact | divided_by: 1000.0 %}
{% assign odo_display = odo_thousands | round: 1 | append: "k " | append: odo_unit %}
{% if ts_ms > 1000000000000 %}{% assign ts_sec = ts_ms | divided_by: 1000 %}{% else %}{% assign ts_sec = ts_ms %}{% endif %}
{% if ts_sec > 0 %}{% assign updated_at = ts_sec | date: "%d/%m %H:%M" %}{% else %}{% assign updated_at = "" %}{% endif %}
{% if updated_at != "" %}{% assign instance_label = vehicle_name | append: " · " | append: updated_at %}{% else %}{% assign instance_label = vehicle_name %}{% endif %}
{% assign charge_limit_label = "Limite " | append: charge_limit | append: "%" %}
{% assign is_fresh = data_fresh %}
{% if is_fresh == true or is_fresh == "true" %}
  {% assign freshness_label = "Données live" %}
{% else %}
  {% assign freshness_label = "Données en cache" %}
  {% if updated_at != "" %}{% assign freshness_label = freshness_label | append: " · " | append: updated_at %}{% endif %}
{% endif %}
<style>
  .ts-full .hero { display: flex; flex-direction: column; gap: 10px; flex: 1; min-height: 0; }
  .ts-full .hero-top { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .ts-full .soc { font-size: 96px; line-height: 0.9; font-weight: 600; letter-spacing: -0.04em; }
  .ts-full .soc-meta { text-align: right; padding-bottom: 8px; }
  .ts-full .soc-meta .label { display: block; font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; }
  .ts-full .soc-meta .status { display: block; font-size: 22px; font-weight: 500; text-transform: capitalize; margin-top: 4px; max-width: 220px; }
  .ts-full .track { position: relative; height: 18px; border: 2px solid #000; background: #fff; }
  .ts-full .fill { height: 100%; background: #000; }
  .ts-full .limit-mark { position: absolute; top: -3px; bottom: -3px; width: 2px; background: #000; }
  .ts-full .limit-caption { margin-top: 6px; font-size: 14px; font-weight: 600; }
  .ts-full .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 2px solid #000; margin-top: 8px; }
  .ts-full .metric { padding: 14px 12px 6px; border-right: 1px solid #000; min-width: 0; }
  .ts-full .metric:nth-child(3n) { border-right: 0; }
  .ts-full .metric:nth-child(n+4) { border-top: 1px solid #000; }
  .ts-full .metric .value { display: block; font-size: 28px; line-height: 1.05; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ts-full .metric .label { display: block; font-size: 13px; font-weight: 600; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
<div class="view view--full ts-full">
  <div class="layout layout--col gap--medium hero">
    <div class="hero-top">
      <div>
        <span class="soc value--tnums">{{ battery_level }}</span><span class="soc" style="font-size:48px;">%</span>
      </div>
      <div class="soc-meta">
        <span class="label">Batterie</span>
        <span class="status" data-clamp="1">{{ charging_state }}{% if vehicle_state != "" %} · {{ vehicle_state }}{% endif %}</span>
        <span class="label" style="margin-top:8px; opacity:0.85;">{{ freshness_label }}</span>
      </div>
    </div>
    <div>
      <div class="track" aria-label="Niveau de batterie">
        <div class="fill" style="width: {{ battery_level }}%;"></div>
        <div class="limit-mark" style="left: {{ charge_limit }}%;" title="{{ charge_limit_label }}"></div>
      </div>
      <div class="limit-caption">{{ charge_limit_label }}</div>
    </div>
    <div class="metrics">
      <div class="metric"><span class="value value--tnums">{{ range_value }} {{ range_unit }}</span><span class="label">Autonomie</span></div>
      <div class="metric"><span class="value value--tnums">{{ power_display }}</span><span class="label">Puissance</span></div>
      <div class="metric"><span class="value value--tnums">{{ time_display }}</span><span class="label">Fin de charge</span></div>
      <div class="metric"><span class="value value--tnums">{{ energy_display }}</span><span class="label">Énergie ajoutée</span></div>
      <div class="metric"><span class="value value--tnums">{{ odo_display }}</span><span class="label">Odomètre</span></div>
      <div class="metric"><span class="value value--tnums">{{ charge_limit }}%</span><span class="label">Objectif SOC</span></div>
    </div>
  </div>
  <div class="title_bar">
    <svg class="image" viewBox="0 0 32 32" role="img" aria-label="TeslaSphere" xmlns="http://www.w3.org/2000/svg"><circle cx="16" cy="16" r="12" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="16" cy="16" r="5" fill="currentColor"/><path d="M16 4v4M16 24v4M4 16h4M24 16h4" stroke="currentColor" stroke-width="2"/></svg>
    <span class="title">TeslaSphere</span>
    <span class="instance">{{ instance_label }}</span>
  </div>
</div>