{% comment %}TeslaSphere — shared Liquid assigns (FR) from flattened vehicle payload{% endcomment %}
{% assign battery_level = battery_level | default: usable_battery_level | default: 0 | plus: 0 %}
{% if battery_level > 100 %}{% assign battery_level = 100 %}{% endif %}
{% if battery_level < 0 %}{% assign battery_level = 0 %}{% endif %}
{% assign charge_limit = charge_limit_soc | default: 80 | plus: 0 %}
{% assign battery_range_raw = battery_range | default: 0 | plus: 0 %}
{% assign energy_added = charge_energy_added | default: 0 | plus: 0 %}
{% comment %}Tesla Fleet time_to_full_charge is hours (float){% endcomment %}
{% assign hours_to_limit = minutes_to_full_charge | default: time_to_full_charge | default: 0 | plus: 0 %}
{% assign charging_state = charging_state | default: "Inconnu" %}
{% assign charger_power = charger_power | default: 0 | plus: 0 %}
{% assign odometer_raw = odometer | default: 0 | plus: 0 %}
{% assign vehicle_name = display_name | default: "Tesla" %}
{% assign vehicle_state = state | default: "" %}
{% assign ts_ms = last_updated_at | default: timestamp | default: 0 | plus: 0 %}
{% assign distance_units = gui_distance_units | default: "km/hr" %}
{% if distance_units contains "mi" %}
  {% assign range_unit = "mi" %}
  {% assign odo_unit = "mi" %}
  {% assign range_value = battery_range_raw | round %}
  {% assign odo_for_compact = odometer_raw %}
{% else %}
  {% assign range_unit = "km" %}
  {% assign odo_unit = "km" %}
  {% assign range_value = battery_range_raw | times: 1.60934 | round %}
  {% assign odo_for_compact = odometer_raw | times: 1.60934 %}
{% endif %}
{% assign energy_display = energy_added | round: 1 | append: " kWh" %}
{% assign power_display = charger_power | round: 1 | append: " kW" %}
{% assign mins_total = hours_to_limit | times: 60 | round %}
{% if mins_total >= 60 %}
  {% assign hrs = mins_total | divided_by: 60 %}
  {% assign mins = mins_total | modulo: 60 %}
  {% if mins > 0 %}
    {% assign time_display = hrs | append: "h " | append: mins | append: "min" %}
  {% else %}
    {% assign time_display = hrs | append: "h" %}
  {% endif %}
{% elsif mins_total > 0 %}
  {% assign time_display = mins_total | append: " min" %}
{% else %}
  {% assign time_display = "—" %}
{% endif %}
{% assign odo_thousands = odo_for_compact | divided_by: 1000.0 %}
{% assign odo_display = odo_thousands | round: 1 | append: "k " | append: odo_unit %}
{% if ts_ms > 1000000000000 %}
  {% assign ts_sec = ts_ms | divided_by: 1000 %}
{% else %}
  {% assign ts_sec = ts_ms %}
{% endif %}
{% if ts_sec > 0 %}
  {% assign updated_at = ts_sec | date: "%d/%m %H:%M" %}
{% else %}
  {% assign updated_at = "" %}
{% endif %}
{% if updated_at != "" %}
  {% assign instance_label = vehicle_name | append: " · " | append: updated_at %}
{% else %}
  {% assign instance_label = vehicle_name %}
{% endif %}
{% assign charge_limit_label = "Limite " | append: charge_limit | append: "%" %}
{% assign remaining_to_limit = charge_limit | minus: battery_level %}
{% if remaining_to_limit < 0 %}{% assign remaining_to_limit = 0 %}{% endif %}
