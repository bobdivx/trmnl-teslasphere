{% comment %}TeslaSphere — shared assigns from the flattened OAuth vehicle payload{% endcomment %}
{% assign battery_level = battery_level | default: usable_battery_level | default: 0 | plus: 0 %}
{% assign charge_limit = charge_limit_soc | default: 80 | plus: 0 %}
{% assign battery_range_raw = battery_range | default: 0 | plus: 0 %}
{% assign energy_added = charge_energy_added | default: 0 | plus: 0 %}
{% assign minutes_to_limit = minutes_to_full_charge | default: time_to_full_charge | default: 0 | plus: 0 %}
{% assign charging_state = charging_state | default: "Unknown" %}
{% assign charger_power = charger_power | default: 0 | plus: 0 %}
{% assign odometer_raw = odometer | default: 0 | plus: 0 %}
{% assign vehicle_name = display_name | default: "Tesla" %}
{% assign ts_ms = timestamp | default: 0 %}
{% assign distance_units = gui_distance_units | default: "mi/hr" %}
{% if distance_units contains "km" %}
 {% assign range_unit = "km" %}
 {% assign odo_unit = "km" %}
 {% assign range_value = battery_range_raw | times: 1.60934 | round %}
 {% assign odo_for_compact = odometer_raw | times: 1.60934 %}
{% else %}
 {% assign range_unit = "mi" %}
 {% assign odo_unit = "mi" %}
 {% assign range_value = battery_range_raw | round %}
 {% assign odo_for_compact = odometer_raw %}
{% endif %}
{% assign energy_display = energy_added | round: 1 | append: " kWh" %}
{% assign power_display = charger_power | append: " kW" %}
{% if minutes_to_limit >= 60 %}
 {% assign hrs = minutes_to_limit | divided_by: 60 %}
 {% assign mins = minutes_to_limit | modulo: 60 %}
 {% if mins > 0 %}
  {% assign time_display = hrs | append: "h " | append: mins | append: "m" %}
 {% else %}
  {% assign time_display = hrs | append: "h" %}
 {% endif %}
{% else %}
 {% assign time_display = minutes_to_limit | append: "m" %}
{% endif %}
{% assign odo_thousands = odo_for_compact | divided_by: 1000.0 %}
{% assign odo_display = odo_thousands | round: 1 | append: "k" %}
{% assign ts_sec = ts_ms | divided_by: 1000 %}
{% if ts_sec > 0 %}{% assign updated_at = ts_sec | date: "%Y/%m/%d %H:%M" %}{% else %}{% assign updated_at = "" %}{% endif %}
{% if updated_at != "" %}{% assign instance_label = vehicle_name | append: " (" | append: updated_at | append: ")" %}{% else %}{% assign instance_label = vehicle_name %}{% endif %}
{% assign time_to_limit_label = "Time to " | append: charge_limit | append: "% Limit" %}
{% assign range_label = "Range (" | append: range_unit | append: ")" %}
{% assign odo_label = "Odometer (" | append: odo_unit | append: ")" %}
